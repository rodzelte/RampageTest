{
  "name": "rampage-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:browser": "tsx --env-file-if-exists=.env scripts/check-browser-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "owner:bootstrap": "tsx --env-file=.env scripts/bootstrap-owner.ts",
    "staff:link-admin": "tsx --env-file=.env scripts/link-admin.ts",
    "bot:start": "tsx --env-file=.env src/bot/index.ts",
    "bot:register": "tsx --env-file=.env scripts/register-bot.ts",
    "topup:simulate": "tsx --env-file=.env scripts/simulate-topup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
